{
  "id": "VNUHCM-HS",
  "version": "1.0.0",
  "names": {
    "vi": "Tạp chí Phát triển KH&CN - Khoa học Sức khỏe",
    "en": "Science & Technology Development Journal - Health Sciences",
    "short": "VNUHCM-HS"
  },
  "color": "#0070BA",
  "languages": ["vi", "en"],
  "articleTypes": [
    {
      "id": "research-article",
      "label": {
        "vi": "Bài báo nghiên cứu",
        "en": "Research Article"
      },
      "requiredSections": ["heading.abstract", "h1", "heading.references"]
    },
    {
      "id": "review-article",
      "label": {
        "vi": "Bài tổng quan",
        "en": "Review"
      },
      "requiredSections": ["heading.abstract", "h1", "heading.references"]
    },
    {
      "id": "case-report",
      "label": {
        "vi": "Báo cáo ca lâm sàng",
        "en": "Case Report"
      },
      "requiredSections": ["heading.abstract", "h1", "heading.references"]
    },
    {
      "id": "methodology",
      "label": {
        "vi": "Phương pháp luận",
        "en": "Methodology"
      },
      "requiredSections": ["heading.abstract", "h1", "heading.references"]
    },
    {
      "id": "commentary",
      "label": {
        "vi": "Bình luận & Ý kiến",
        "en": "Commentary"
      },
      "requiredSections": ["heading.abstract", "h1", "heading.references"]
    },
    {
      "id": "correction",
      "label": {
        "vi": "Đính chính",
        "en": "Correction"
      },
      "requiredSections": ["h1"]
    },
    {
      "id": "editorial",
      "label": {
        "vi": "Bài xã luận",
        "en": "Editorial"
      },
      "requiredSections": ["h1"]
    },
    {
      "id": "letter",
      "label": {
        "vi": "Thư gửi tòa soạn",
        "en": "Letter"
      },
      "requiredSections": ["h1"]
    }
  ],
  "frontMatter": {
    "abstract": {
      "minWords": 275,
      "maxWords": 500,
      "structured": true
    },
    "keywords": {
      "min": 3,
      "max": 5,
      "separator": ";"
    },
    "dateFormat": "YYYY-MM-DD",
    "doiPattern": "^10\\.32508/vnuhcm-hs\\.\\d+$"
  },
  "citation": {
    "style": "vancouver",
    "inText": "bracket",
    "rangeDash": "-"
  },
  "styleMap": {
    "ArticleTitle": "title",
    "Authors": "authors",
    "Affiliation": "affiliations",
    "CorrespondingAuthor": "corresponding",
    "DateReceived": "date.received",
    "DateRevised": "date.revised",
    "DateAccepted": "date.accepted",
    "DatePublished": "date.published",
    "SectionAbstract": "heading.abstract",
    "Abstract": "abstract",
    "Keywords": "keywords",
    "Heading1": "h1",
    "Heading2": "h2",
    "Heading3": "h3",
    "BodyText": "paragraph",
    "TableCaption": "table.caption",
    "TableText": "table.cell",
    "TableNote": "table.note",
    "SourceLine": "source",
    "FigureCaption": "figure.caption",
    "FigurePlaceholder": "figure.placeholder",
    "Equation": "equation",
    "Reference": "reference",
    "EndNoteBibliography": "reference",
    "SectionReferences": "heading.references",
    "SectionEthics": "back.ethics",
    "SectionAcknowledgments": "back.acknowledgments",
    "SectionFunding": "back.funding",
    "SectionContributions": "back.contributions",
    "SectionConflict": "back.conflict",
    "SectionDataAvailability": "back.data_availability",
    "Instruction": "ignore",
    "GuideHeading1": "ignore",
    "GuideHeading2": "ignore",
    "GuideText": "ignore"
  },
  "layout": {
    "paperSize": "A4",
    "columns": 2,
    "columnGap": 6.0,
    "margins": {
      "top": 20.0,
      "bottom": 20.0,
      "left": 20.0,
      "right": 20.0,
      "unit": "mm"
    },
    "headerHeight": 12.0,
    "footerHeight": 12.0
  },
  "typography": {
    "fontFamilies": {
      "main": "Times New Roman",
      "heading": "Times New Roman",
      "mono": "Courier New"
    },
    "fontSizes": {
      "title": 18,
      "heading1": 13,
      "heading2": 11,
      "heading3": 10,
      "body": 10,
      "caption": 9,
      "table": 8.5,
      "reference": 8.5
    },
    "leading": {
      "body": 1.15,
      "heading": 1.2
    },
    "widowOrphan": {
      "widows": 2,
      "orphans": 2
    }
  },
  "latex": {
    "cls": "structpaper-hs.cls",
    "engine": "xelatex",
    "fonts": {
      "main": "Times New Roman",
      "sans": "Arial",
      "mono": "Courier New"
    }
  },
  "qc": {
    "ruleset": [
      "title-required",
      "authors-required",
      "affiliations-required",
      "abstract-word-count",
      "keywords-count",
      "vancouver-citation-format",
      "references-numbered",
      "table-captions-required",
      "figure-captions-required",
      "ethics-statement-required",
      "conflict-of-interest-required"
    ],
    "weights": {
      "frontMatter": 0.3,
      "sections": 0.25,
      "tables": 0.15,
      "figures": 0.15,
      "references": 0.15
    }
  }
}
