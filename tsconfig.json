{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@structpaper/*": ["./packages/*/src"],
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "apps/web/src/**/*",
    "contracts/**/*",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
